# Copy to .env.local (gitignored). Never commit real values.

# PUBLIC — anything prefixed VITE_ is inlined into the client bundle. Only put
# non-secret values here. The confirmed production origin, no trailing slash.
# Until it is set, the build uses the documented placeholder https://shift.example
# for canonical URLs, Open Graph URLs and the sitemap.
VITE_SITE_URL=

# SERVER-ONLY placeholders for the launch-list provider, when one is chosen.
# These are NOT read by the current prototype: the signup form is a labelled
# demo that transmits nothing. Wire them up in a server function only.
SIGNUP_PROVIDER=
SIGNUP_PROVIDER_API_KEY=
SIGNUP_PROVIDER_LIST_ID=
